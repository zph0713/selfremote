# 开发/预发栈环境变量（复制为 .env.dev 后使用；.env.dev 已被 gitignore）
#
#   cd deploy/stack
#   cp .env.dev.example .env.dev
#   # 改两个密码，其它默认值即可
#
# 约定：所有命令都在 deploy/stack 目录下执行（与生产文档一致），因此
# SR_CONFIG_DIR 的相对路径以 deploy/stack 为基准。
# 关键：这里的端口/镜像/数据目录与生产栈全部错开，确保互不影响。

# --- 数据库密码（开发库，随便设，不要和生产相同）---
DB_ROOT_PASSWORD=dev-root-change-me
DB_PASSWORD=dev-app-change-me

# --- 隔离：数据目录、镜像标签、端口 ---
SR_CONFIG_DIR=./data-dev
SR_IMAGE=selfremote:dev
SR_WEB_IMAGE=selfremote-web:dev

# 生产用 8080/28080/28333/8770；开发全部挪开
HTTP_PORT=18080
HTTP_ALT_PORT=18081
TUNNEL_PORT=28334
API_PORT=8771

# 控制面容器怎么找管控 API（桥接网络 → 宿主发布端口）
SRV_API_URL=http://host.docker.internal:8771

# 客户端密钥里写的服务端地址（换成这台机器的 IP 或域名）
SERVER_ADDR=127.0.0.1:28334

# 本机站点要开放的网段（开发机上没有像样的内网时，留一个不存在的网段即可）
LAN_CIDRS=192.168.99.0/24

# 控制面走 HTTPS 时设为 1
COOKIE_SECURE=0
