# 复制为 .env 后修改（docker compose 会自动读取本文件）
# --- 数据库 ---
DB_ROOT_PASSWORD=change-me-root-password
DB_PASSWORD=change-me-app-password

# --- 数据目录（网关配置 gateway.json、白名单 clients.json、状态文件都在这里）---
# 群晖建议用绝对路径，例如 /volume1/docker/selfremote
SR_CONFIG_DIR=./data

# --- 访问与端口 ---
HTTP_PORT=8080
TUNNEL_PORT=28333

# --- 客户端接入地址：留空 = 自动探测本机公网 IPv6/IPv4 ---
# 也可以显式指定，例如：
#   SERVER_ADDR=[240e:xxxx:xxxx:xxxx::1]:28333
#   SERVER_ADDR=nas.example.com:28333
SERVER_ADDR=

# --- 家里内网网段（写进生成的客户端配置；逗号分隔多个）---
LAN_CIDRS=192.168.1.0/24

# --- 群晖专用（可选）---
# 开启 Open vSwitch 的群晖把 LAN 接口设为 ovs_eth0
# SR_LAN_IF=eth0
# SR_TUNNEL_CIDR=10.77.0.0/24

# --- 高级：用本地构建的镜像时覆盖（默认拉取 ghcr.io 公共镜像）---
# SR_IMAGE=selfremote:latest
# SR_WEB_IMAGE=selfremote-web:latest
