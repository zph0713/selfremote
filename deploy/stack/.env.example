# 复制为 .env 后修改（docker compose 会自动读取本文件）
# --- 数据库 ---
DB_ROOT_PASSWORD=***
DB_PASSWORD=***

# --- 数据目录（server.json / clients.json / agents.json / 站点配置都在这里）---
# 群晖建议用绝对路径，例如 /volume1/docker/selfremote
SR_CONFIG_DIR=./data

# --- 访问与端口 ---
HTTP_PORT=8080
TUNNEL_PORT=28333
# 控制 API 端口（只给控制面容器用；不要对公网开放）
API_PORT=8770

# --- 客户端/站点接入地址：留空 = 自动探测本机公网 IPv6/IPv4 ---
# 也可以显式指定，例如：
#   SERVER_ADDR=[240e:xxxx:xxxx:xxxx::1]:28333
#   SERVER_ADDR=nas.example.com:28333
#   SERVER_ADDR=127.0.0.1:28333（仅本机 Docker Desktop 试验）
SERVER_ADDR=

# --- 本机内网网段（作为「home 站点」的默认建议值；实际以网页里创建的站点为准）---
LAN_CIDRS=192.168.1.0/24

# --- 本机站点 agent（agent-home 容器）的文件密码 ---
# 必须与你在网页下载部署包时设置的密码一致；容器用它解密 <站点id>.srkey
SR_AGENT_KEYPASS=请在网页下载部署包时设置同样的密码

# --- 高级：用本地构建的镜像时覆盖（默认拉取 ghcr.io 公共镜像）---
# SR_IMAGE=selfremote:latest
# SR_WEB_IMAGE=selfremote-web:latest
# 隧道网段（改这里要同步 server.json 与站点配置）
# SR_TUNNEL_CIDR=10.77.0.0/24
