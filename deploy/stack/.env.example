# 复制为 .env 后修改（docker compose 会自动读取本文件）
# --- 数据库 ---
DB_ROOT_PASSWORD=***
DB_PASSWORD=***

# --- 数据目录（server.json / agent-home.json / 注册表都在这里）---
# 群晖建议用绝对路径，例如 /volume1/docker/selfremote
SR_CONFIG_DIR=./data

# --- 端口 ---
# 控制面网页端口（浏览器访问 http://<主机>:8080）
HTTP_PORT=8080
# 控制面备用端口：部分家宽拦截入站的 80/8080/8443 等常见端口，
# 外网访问不通时换成这个（可改成任意空闲端口）
HTTP_ALT_PORT=28080
# 隧道 UDP 端口（客户端与站点都连它；公网需要放行 UDP）
TUNNEL_PORT=28333
# 中转服务端的管控 API 端口（只给控制面容器用，不要暴露到公网）
API_PORT=8770

# --- 服务端对外地址（客户端/站点密钥里会快照这个值）---
# 留空 = 控制面自动从服务端的 netinfo.json 探测公网 IPv6/IPv4；也可以显式写死，如
#   SERVER_ADDR=[240e:xxxx::1]:28333   或   SERVER_ADDR=nas.example.com:28333
SERVER_ADDR=

# --- 本机站点（server 自己所在的内网；初次部署时自动装好）---
# 要开放的网段，逗号分隔（多网段都写进来）
LAN_CIDRS=192.168.1.0/24
# 站点 id / 显示名（默认 home / 本机站点）
HOME_SITE_ID=home
HOME_SITE_NAME=本机站点

# --- 镜像（默认用官方镜像；本机源码构建时可改成自己的 tag）---
# SR_IMAGE=ghcr.io/zph0713/selfremote:latest
# SR_WEB_IMAGE=ghcr.io/zph0713/selfremote-web:latest
